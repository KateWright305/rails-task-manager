<h1><%= @task.title %></h1>

<p><%= @task.details %></p>
<p><%= @task.completed ? "This task is completed" : "This task is not completed" %></p>

<p><%= link_to "Edit", edit_task_path %></p>

<p><%= link_to "Back to list", tasks_path %></p>

<p>
  <%= link_to task_path(@task),
    data: {turbo_method: :delete, turbo_confirm: "Are you sure?"} do %>
    <i class="fa-solid fa-trash-can"></i>
  <% end %>
</p>
